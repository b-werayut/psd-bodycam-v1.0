<mxfile host="Electron" agent="claude-code" version="24.0.0" type="device"><diagram id="prod" name="Production (team3)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;PSD Body worn camera — Infrastructure (Production)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="สอดคล้องกับ system-architecture.drawio + Part 2 §2.3 · infra จริงจาก psd-bwc-frontend / psd-bwc-web-backend / psd-bwc-dss-services · Booking = &lt;i&gt;[Assumption]&lt;/i&gt; · หัวลูกศร = ฝั่งที่ถูกเรียก (request / poll)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#57606A;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2000" height="22" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;SSO (OIDC)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="200" height="75" as="geometry"/></mxCell><mxCell id="fcm" value="&lt;b&gt;Firebase Cloud Messaging&lt;/b&gt;&lt;br&gt;push notification&lt;br&gt;→ Mobile app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="95" width="210" height="70" as="geometry"/></mxCell><mxCell id="booking" value="&lt;b&gt;Booking System&lt;/b&gt;&lt;br&gt;ต้นทางใบงานเดียว · check-in / check-out&lt;br&gt;&lt;i&gt;[Assumption]&lt;/i&gt; API spec รอทีม Booking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="92" width="260" height="84" as="geometry"/></mxCell><mxCell id="leader" value="&lt;b&gt;หัวหน้าทีม / Admin ฝั่ง Booking&lt;/b&gt;&lt;br&gt;Booking app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1900" y="95" width="200" height="70" as="geometry"/></mxCell><mxCell id="g_users" value="ผู้ใช้ (Clients)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#1F2328;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="310" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;ADMIN · OPERATOR · VIEWER&lt;br&gt;เมนูหลัก: Live · หลักฐาน&lt;br&gt;(playback) · แผนที่" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="g_users"><mxGeometry x="15" y="40" width="170" height="110" as="geometry"/></mxCell><mxCell id="mobile" value="&lt;b&gt;Mobile app&lt;/b&gt;&lt;br&gt;OPERATOR · ADMIN · VIEWER&lt;br&gt;monitoring + ตรวจหลักฐาน&lt;br&gt;รับ push (FCM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="g_users"><mxGeometry x="15" y="180" width="170" height="110" as="geometry"/></mxCell><mxCell id="g_ns" value="Kubernetes — namespace team3 (ของทีม · ร่วมกับระบบเดิม · GitOps)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#1F2328;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="930" height="730" as="geometry"/></mxCell><mxCell id="ingress" value="&lt;b&gt;Ingress / LB&lt;/b&gt;&lt;br&gt;&lt;br&gt;TLS termination&lt;br&gt;&lt;br&gt;ทุก path → web&lt;br&gt;(DL29)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57606A&quot;&gt;ค่าจริงอยู่ใน&lt;br&gt;gitops-*-nwl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="g_ns"><mxGeometry x="20" y="40" width="160" height="350" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;web&lt;/b&gt; (Deployment)&lt;br&gt;nginx + React 18 SPA&lt;br&gt;nginx 1.30.6-alpine · :8080 non-root&lt;br&gt;proxy /api/ · /api/talk/ws · /socket.io/&lt;br&gt;→ BACKEND_URL (ต้องตั้ง)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#E6F0FA;strokeColor=#6C8EBF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="g_ns"><mxGeometry x="220" y="40" width="220" height="140" as="geometry"/></mxCell><mxCell id="config" value="&lt;b&gt;Secret / ConfigMap&lt;/b&gt;&lt;br&gt;env ชุดเดียว: api + worker-*&lt;br&gt;DATABASE_URL · REDIS_URL&lt;br&gt;WORKER_ROLES&lt;br&gt;BOOKING_PROVIDER_DRIVER&lt;br&gt;STORAGE_DRIVER=local&lt;br&gt;JWT · USER_DSS / PWD_DSS&lt;br&gt;FCM_* · AZURE_AD_* · TRUST_PROXY=2&lt;br&gt;prod:check ก่อน deploy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="g_ns"><mxGeometry x="220" y="220" width="220" height="170" as="geometry"/></mxCell><mxCell id="migrate" value="&lt;b&gt;migrate&lt;/b&gt; (Job ก่อน rollout)&lt;br&gt;node dist/db/migrate.entry.js&lt;br&gt;data migration: roles ·&lt;br&gt;permissions · settings&lt;br&gt;&lt;b&gt;ปล่อย api ก่อน web เสมอ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="g_ns"><mxGeometry x="220" y="420" width="220" height="120" as="geometry"/></mxCell><mxCell id="w_int" value="&lt;b&gt;worker-integration&lt;/b&gt; × 1..N &amp;nbsp;&lt;font color=&quot;#57606A&quot;&gt;WORKER_ROLES=integration&lt;/font&gt;&lt;br&gt;booking-sync (pull): change feed 2m · full 02:00&lt;br&gt;booking-inbox: upsert BookingJobs + WorkOrders 1:1 (tx เดียว)&lt;br&gt;matching: session → ใบงาน Booking · notification-push (FCM)&lt;br&gt;BookingProvider port: mock | http | csv · breaker · timeout 8s&lt;br&gt;&lt;i&gt;pull อย่างเดียว (DL31) — ไม่มี webhook / write-back&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="g_ns"><mxGeometry x="490" y="40" width="420" height="140" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;api&lt;/b&gt; pod × N &amp;nbsp;&lt;font color=&quot;#57606A&quot;&gt;main.api.ts · :3000&lt;/font&gt;&lt;br&gt;svc &amp;lt;api-service&amp;gt;.team3.svc:3000 = BACKEND_URL ของ web&lt;br&gt;REST /api/* · envelope · RBAC + scope&lt;br&gt;Guard: JwtAuth → RateLimit → Permissions + @Audit&lt;br&gt;RealtimeGateway Socket.IO /realtime (Redis adapter)&lt;br&gt;Talk WebSocket /api/talk/ws · Stream proxy (HLS, sealed URL AES-256-GCM)&lt;br&gt;Deep link จาก Booking: /work-orders/by-booking/:jobId&lt;br&gt;ดาวน์โหลด MP4 (download ticket) จาก PVC&lt;br&gt;health · /api/metrics · requests กัน CPU / mem (DL39)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="g_ns"><mxGeometry x="490" y="210" width="420" height="200" as="geometry"/></mxCell><mxCell id="w_trk" value="&lt;b&gt;worker-tracking&lt;/b&gt; × 1 (active) &amp;nbsp;&lt;font color=&quot;#57606A&quot;&gt;WORKER_ROLES=tracking · Redis lock&lt;/font&gt;&lt;br&gt;GpsPoll 15s — DSS /location: GPS + online/offline ชุดเดียวกัน (DL32)&lt;br&gt;SessionSweep 30s: FOR UPDATE + decide() · AlertSweep 60s&lt;br&gt;Partition / Retention รายวัน: GPS 3 เดือน · ใบงาน 3 เดือน · audit 12 เดือน&lt;br&gt;&lt;i&gt;Real-time path: ไม่เรียก Booking&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;strokeWidth=2;" vertex="1" parent="g_ns"><mxGeometry x="490" y="440" width="420" height="130" as="geometry"/></mxCell><mxCell id="w_med" value="&lt;b&gt;worker-media&lt;/b&gt; × 1..N &amp;nbsp;&lt;font color=&quot;#57606A&quot;&gt;WORKER_ROLES=media · image มี ffmpeg&lt;/font&gt;&lt;br&gt;evidence-export: DSS segment → ffmpeg (-c:v copy) → MP4 บน PVC&lt;br&gt;recording-index · StreamIdle · TalkIdle · EvidenceCleanup 60s&lt;br&gt;limits CPU 1 / 1 GiB · EVIDENCE_EXPORT_CONCURRENCY=1 (DL39)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="g_ns"><mxGeometry x="490" y="600" width="420" height="110" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;กติกาสำคัญ&lt;/b&gt; (ตาม system diagram)&lt;br&gt;• ใบงานมาจาก Booking sync เท่านั้น · 1 Booking job = 1 WO · สถานะ: sync = Planned · check-in = Open · check-out = Closed&lt;br&gt;• session ผูกใบงานด้วย matching อัตโนมัติ · rematch เมื่อข้อมูล Booking มา · ไม่มีการผูกมือ&lt;br&gt;• Real-time path (DSS → worker-tracking → Socket.IO) ไม่เรียก Booking · Booking ล่ม แผนที่ / session / live / playback ยังทำงาน&lt;br&gt;• สถานะกล้องบนหน้าจอ: api ดึงจาก DSS ตอนเปิดดู (ไม่มี push &lt;code&gt;device:status&lt;/code&gt; — DL35)&lt;br&gt;• Emit realtime หลัง commit เท่านั้น · worker emit ผ่าน redis-emitter → api Socket.IO&lt;br&gt;• Nest ↔ dss-services เป็น HTTP: talk ต้องเข้ารหัส (TLS / VPN) ก่อนใช้ production&lt;br&gt;• pilot: รวม worker เป็น pod เดียวได้ด้วย WORKER_ROLES=tracking,integration,media" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#FFFDE7;strokeColor=#BFA100;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1290" y="230" width="810" height="195" as="geometry"/></mxCell><mxCell id="g_onprem" value="PSD on-premise" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#1F2328;fillColor=#FAFAFA;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1275" y="440" width="580" height="515" as="geometry"/></mxCell><mxCell id="g_vm" value="PSD Server (VM) · xxx.xxx.x.xx" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#1F2328;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="g_onprem"><mxGeometry x="15" y="30" width="240" height="470" as="geometry"/></mxCell><mxCell id="dss_svc" value="&lt;b&gt;DSS middleware&lt;/b&gt;&lt;br&gt;psd-bwc-dss-services&lt;br&gt;FastAPI · Python 3.12&lt;br&gt;รันบน PSD Server&lt;br&gt;xxx.xxx.x.xx:3004&lt;br&gt;&lt;br&gt;systemd · &lt;b&gt;WORKERS=1 · instance เดียว&lt;/b&gt;&lt;br&gt;state + token DSS อยู่ใน memory&lt;br&gt;&lt;br&gt;/api/v1: location (GPS + online/offline)&lt;br&gt;devices · stream · playback&lt;br&gt;recording/search · talk WS&lt;br&gt;/proxy HLS · /health → journald" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="g_vm"><mxGeometry x="15" y="30" width="210" height="420" as="geometry"/></mxCell><mxCell id="g_dahua" value="Dahua DSS Platform · xxx.xxx.x.xx" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#1F2328;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="g_onprem"><mxGeometry x="325" y="30" width="240" height="470" as="geometry"/></mxCell><mxCell id="dss" value="&lt;b&gt;Dahua DSS Platform&lt;/b&gt;&lt;br&gt;(VMS กล้องของ Dahua)&lt;br&gt;&lt;br&gt;ทะเบียนอุปกรณ์&lt;br&gt;media server (live / record)&lt;br&gt;RTSP talk&lt;br&gt;&lt;br&gt;:443 REST API&lt;br&gt;:7086 media (HLS / playback)&lt;br&gt;:9100 RTSP talk&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57606A&quot;&gt;วิดีโอต้นฉบับเก็บที่นี่&lt;br&gt;(retention 3 เดือน ฝั่ง infra)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#E0E0E0;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;strokeWidth=2;" vertex="1" parent="g_dahua"><mxGeometry x="15" y="30" width="210" height="420" as="geometry"/></mxCell><mxCell id="g_field" value="ภาคสนาม (Field)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#1F2328;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1900" y="470" width="200" height="470" as="geometry"/></mxCell><mxCell id="cams" value="&lt;b&gt;Bodycam devices&lt;/b&gt;&lt;br&gt;(4G)&lt;br&gt;&lt;br&gt;ลงทะเบียนกับ&lt;br&gt;Dahua DSS Platform&lt;br&gt;ส่งภาพ / GPS / สถานะ&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57606A&quot;&gt;ระบบนี้ไม่คุยกับกล้องโดยตรง&lt;br&gt;“กล้องเปิด” มาจาก&lt;br&gt;platform status ไม่ใช่ GPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fontColor=#1F2328;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="g_field"><mxGeometry x="15" y="30" width="170" height="420" as="geometry"/></mxCell><mxCell id="g_data" value="Data tier (ตำแหน่งจริงกำหนดใน gitops / ทีม infra)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#1F2328;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="980" width="930" height="190" as="geometry"/></mxCell><mxCell id="pvc" value="&lt;b&gt;Local disk (PVC)&lt;/b&gt;&lt;br&gt;STORAGE_DRIVER=local&lt;br&gt;MP4 export ชั่วคราว · ลบหลัง 24 ชม.&lt;br&gt;mount: api + worker-media&lt;br&gt;คนละ node ⇒ ReadWriteMany (R16)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fontColor=#1F2328;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="g_data"><mxGeometry x="20" y="25" width="240" height="130" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL 16 + btree_gist&lt;/b&gt;&lt;br&gt;จาก Booking: BookingJobs · WorkOrders · IntegrationInbox&lt;br&gt;DeviceState · TrackingSessions · MatchAttempts&lt;br&gt;RecordingSegments · EvidenceExports&lt;br&gt;partition รายเดือน: GpsLocations · AuditLogs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fontColor=#1F2328;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidt