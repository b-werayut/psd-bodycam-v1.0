# =============================================================================
# PSD Body worn camera — ตัวอย่าง env ของ server บน production (Kubernetes namespace `team3`)
# =============================================================================
# ไฟล์นี้ commit ลง git จึงมีแต่ค่าตัวอย่าง — ค่าจริงใส่ใน Kubernetes Secret / ConfigMap
# (หรือ variable group ของ Azure pipeline) เท่านั้น ห้ามใส่ค่าจริงในไฟล์นี้
# ค่า dev บนเครื่อง local ดู `.env.example`
#
# ป้ายกำกับ:
#   [Secret]     ใส่ใน Kubernetes Secret
#   [Config]     ใส่ใน ConfigMap ได้ (ไม่ใช่ความลับ)
#   [ใช้แล้ว]    code ตอนนี้อ่านค่านี้แล้ว
#   [P3a] [P4] [P5]  code จะเริ่มอ่านใน phase นั้น (Part 8) — ยังไม่ต้องใส่
#   [prod:check] `npm run prod:check` ตรวจค่านี้ — รันกับ env ชุดนี้ก่อน deploy ทุกครั้ง
#
# โปรเซสที่ใช้ env ชุดนี้ (image เดียวกัน):
#   api       node dist/main.api.js
#   worker    node dist/main.worker.js          (ไม่เปิดพอร์ต · ระบบเดิมไม่มี — Deployment ใหม่)
#   migrate   node dist/db/migrate.entry.js     (รันก่อน api / worker ทุกครั้งที่ deploy)
#
# แทนระบบเดิม `psd-bwc-web-backend` (DL60) — env ของระบบเดิมที่ต้องลบ / เปลี่ยน ดูท้ายไฟล์
# =============================================================================


# -----------------------------------------------------------------------------
# 1. โปรเซส
# -----------------------------------------------------------------------------
# [Config] [ใช้แล้ว] [prod:check]
NODE_ENV=production

# [Config] [ใช้แล้ว] พอร์ตของ api (Service / nginx ของ web ชี้มาที่พอร์ตนี้)
PORT=3000

# [Config] [ใช้แล้ว] ระดับ log ของ pino — ไม่ตั้ง = info บน production
# LOG_LEVEL=info

# [Config] [ใช้แล้ว] Swagger UI ที่ /api/docs — production ปิดเว้นแต่ตั้ง true
# SWAGGER_ENABLED=false

# [Config] [ใช้แล้ว] เฉพาะ Deployment ของ worker: tracking, integration, media คั่นด้วย comma
# ไม่ตั้ง = ทุกบทบาทในโปรเซสเดียว · แยกเป็นหลาย Deployment ได้โดยไม่ต้องแก้ code
# WORKER_ROLES=tracking,integration,media


# -----------------------------------------------------------------------------
# 2. ฐานข้อมูล PostgreSQL
# -----------------------------------------------------------------------------
# [Secret] [ใช้แล้ว] [prod:check]
# ⚠️ database ใหม่ของระบบนี้ (`bwc`) เท่านั้น — ห้ามชี้ DB ของระบบเดิม
#    (ชื่อตารางและ `drizzle.__drizzle_migrations` ชนกัน)
# password ที่มีอักขระพิเศษต้อง URL-encode เช่น '@' -> %40, '#' -> %23
DATABASE_URL=postgres://bwc:CHANGE_ME@CHANGE_ME_DB_HOST:5432/bwc

# [Config] [ใช้แล้ว] migration ค้างตอน boot: enforce (ค่าเริ่มต้น — ค้างแล้วไม่ boot) | warn | off
# DB_MIGRATION_CHECK=enforce

# [Config] [ใช้แล้ว] migrate รอ lock ของอีกตัวที่กำลัง migrate อยู่ได้นานเท่านี้ (วินาที) — ไม่ตั้ง = 120
# DB_MIGRATE_LOCK_WAIT_SECONDS=120


# -----------------------------------------------------------------------------
# 3. Redis — Socket.IO, lock, rate limit, BullMQ, cache สถานะกล้อง
# -----------------------------------------------------------------------------
# [Secret] [ใช้แล้ว] [prod:check] ใส่รหัสผ่านใน URL ถ้ามี: redis://:CHANGE_ME@host:6379
# key ทุกตัวมีชื่อ database นำหน้าอยู่แล้ว จึงใช้ Redis ร่วมกับระบบอื่นได้
REDIS_URL=redis://CHANGE_ME_REDIS_HOST:6379

# [Config] [ใช้แล้ว] timeout ตอนต่อ Redis (ms) — ไม่ตั้ง = 5000
# REDIS_CONNECT_TIMEOUT_MS=5000


# -----------------------------------------------------------------------------
# 4. หน้าเว็บ + reverse proxy + cookie
# -----------------------------------------------------------------------------
# [Config] [ใช้แล้ว] [prod:check] origin ของหน้าเว็บ (https) คั่นด้วย comma · ห้ามใช้ `*`
CORS_ORIGINS=https://CHANGE_ME_WEB_DOMAIN

# [Config] [ใช้แล้ว] [prod:check] จำนวนชั้น proxy หน้า api: ingress + nginx ของ web = 2
# ห้ามตั้ง true / all / * (ผู้เรียกปลอม X-Forwarded-For ได้) · ผิดแล้ว IP ใน audit log เป็นของ proxy หมด
TRUST_PROXY=2

# [Config] [ใช้แล้ว] [prod:check] ต้องเป็น true บน HTTPS
COOKIE_SECURE=true

# [Config] [ใช้แล้ว] [prod:check] SameSite ของ refresh cookie — lax เมื่อเว็บกับ api อยู่โดเมนเดียวกัน
COOKIE_SAMESITE=lax


# -----------------------------------------------------------------------------
# 5. Auth (ชื่อผู้ใช้ + รหัสผ่าน, JWT, refresh token)
# -----------------------------------------------------------------------------
# [Secret] [ใช้แล้ว] [prod:check] อย่างน้อย 32 ตัวอักษรที่สุ่มมา: openssl rand -base64 48
# ไม่ตั้ง = boot ไม่ขึ้น
JWT_ACCESS_SECRET=CHANGE_ME_random_at_least_32_characters

# [Config] [ใช้แล้ว] อายุ access token
ACCESS_TOKEN_TTL=15m

# [Config] [ใช้แล้ว] [prod:check] อายุ refresh token ของเว็บ (ชั่วโมง) — เกิน 24 จะถูกเตือน
REFRESH_TOKEN_TTL_HOURS=8

# [Config] [P5] [prod:check] อายุ refresh token ของแอปมือถือที่ลงทะเบียนเครื่อง (ชั่วโมง) — ไม่ตั้ง = เท่ากับเว็บ
# REFRESH_TOKEN_TTL_HOURS_DEVICE=720

# [Config] [ใช้แล้ว] [prod:check] login ด้วยชื่อผู้ใช้ + รหัสผ่าน (หัวหน้าทีมที่ไม่มีบัญชี Entra ต้องใช้ — DL49)
AUTH_PASSWORD_LOGIN_ENABLED=true

# [Config] [ใช้แล้ว] โควตาต่อ IP ต่อนาที — ไม่ตั้ง = ค่าในวงเล็บ
# AUTH_LOGIN_RATE_LIMIT_PER_MIN=60
# AUTH_SSO_RATE_LIMIT_PER_MIN=60
# AUTH_REFRESH_RATE_LIMIT_PER_MIN=120

# ⚠️ ห้ามตั้ง SEED_ADMIN_PASSWORD / SEED_DEMO_PASSWORD บน production
#    (seed ใช้ได้เฉพาะ dev · prod:check fail เมื่อมี SEED_DEMO_PASSWORD)


# -----------------------------------------------------------------------------
# 6. Microsoft Entra ID — เข้าสู่ระบบด้วยบัญชีองค์กร (SSO)
# -----------------------------------------------------------------------------
# [Config] [ใช้แล้ว] [prod:check] App registration ของ SSO > Overview (GUID ทั้งคู่)
# แอปต้องมี Redirect URI แบบ SPA = https://CHANGE_ME_WEB_DOMAIN
AZURE_AD_TENANT_ID=CHANGE_ME_TENANT_GUID
AZURE_AD_CLIENT_ID=CHANGE_ME_CLIENT_GUID

# [Config] [ใช้แล้ว] จำกัดโดเมนอีเมลที่เข้าได้ คั่นด้วย comma — ว่าง = ไม่จำกัด
# AZURE_AD_ALLOWED_EMAIL_DOMAINS=


# -----------------------------------------------------------------------------
# 7. Microsoft Graph — หน้า ผู้ใช้จาก Entra (`/entra-users`)
# -----------------------------------------------------------------------------
# App registration คนละตัวกับ SSO: Application permission `User.Read.All` + admin consent
# ไม่ตั้ง = ระบบใช้ได้ แต่หน้า ผู้ใช้จาก Entra ตอบ 400 GRAPH_NOT_CONFIGURED
# [Config] [ใช้แล้ว] ไม่ตั้ง = ใช้ AZURE_AD_TENANT_ID
GRAPH_TENANT_ID=CHANGE_ME_TENANT_GUID
# [Config] [ใช้แล้ว]
GRAPH_CLIENT_ID=CHANGE_ME_GRAPH_CLIENT_GUID
# [Secret] [ใช้แล้ว] จดวันหมดอายุของ secret ไว้ — หมดแล้วหน้า ผู้ใช้จาก Entra ใช้ไม่ได้
GRAPH_CLIENT_SECRET=CHANGE_ME

# [Config] [ใช้แล้ว] ดึงเฉพาะบัญชีที่โดเมนตรง คั่นด้วย comma — ไม่ตั้ง = ใช้ AZURE_AD_ALLOWED_EMAIL_DOMAINS
GRAPH_ALLOWED_DOMAINS=CHANGE_ME_EMAIL_DOMAIN
# [Config] [ใช้แล้ว] เทียบโดเมนกับ userPrincipalName (ค่าเริ่มต้น) | mail
GRAPH_DOMAIN_FIELD=userPrincipalName


# -----------------------------------------------------------------------------
# 8. DSS middleware (`psd-bwc-dss-services`) — GPS + สถานะกล้อง, รายการกล้อง
# -----------------------------------------------------------------------------
# [Config] [ใช้แล้ว] [prod:check] ต้องเป็น dss — mock = ทั้งระบบใช้กล้องจำลอง
DSS_DRIVER=dss

# [Config] [ใช้แล้ว] [prod:check] host:port ของ psd-bwc-dss-services ไม่ต้องมี path (/api/v1 ระบบต่อเอง)
# แทน LOCATION_API_URL / DEVICE_LIST_API_URL ของระบบเดิม — ใช้ host:port เดียวกัน (DL75)
DSS_BASE_URL=http://CHANGE_ME_DSS_HOST:3004

# [Secret] [ใช้แล้ว] [prod:check] = API_SECRET_KEY ใน .env ของ psd-bwc-dss-services (32 ตัวขึ้นไป)
# นาฬิกาของ server นี้กับเครื่อง DSS middleware ต้องคลาดกันไม่เกิน 30 วินาที
DSS_API_KEY=CHANGE_ME

# [Config] [ใช้แล้ว] timeout ต่อคำขอ (ms) 1000–60000 — ไม่ตั้ง = 10000
# DSS_TIMEOUT_MS=10000

# [Config] [ใช้แล้ว] worker role tracking: ดึงพิกัด + สถานะกล้องทุกรอบ
# (รอบตั้งที่หน้า ตั้งค่าระบบ `gps.poll-interval-seconds`)
GPS_POLL_ENABLED=true
# [Config] [ใช้แล้ว] จำนวนคำขอ /location พร้อมกัน (1–32)
GPS_POLL_CONCURRENCY=8


# -----------------------------------------------------------------------------
# 9. ไฟล์ export MP4 (วิดีโอย้อนหลัง) — Local disk บน PVC, ลบหลัง 24 ชม. (DL34)
# -----------------------------------------------------------------------------
# [Config] [P4] api กับ worker media ต้อง mount PVC เดียวกันที่ path นี้
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/CHANGE_ME_PVC_MOUNT_PATH

# [Config] [P4] งานแปลงพร้อมกันของ worker media (1–8) และ timeout ต่องาน (นาที)
# EVIDENCE_EXPORT_CONCURRENCY=1
# EVIDENCE_EXPORT_TIMEOUT_MINUTES=180


# -----------------------------------------------------------------------------
# 10. Booking (Smart Booking) — [P3a] ยังไม่ต้องใส่ (code ยังไม่อ่าน · รอ spec จากทีม Booking)
# -----------------------------------------------------------------------------
# [Config] hmac (ค่าเริ่มต้น) | api-key
# BOOKING_INBOUND_AUTH=hmac
# [Secret] secret ขาเข้า คั่นด้วย comma ได้ 2 ตัว (หมุน secret โดยไม่ดับ)
# BOOKING_INBOUND_SECRETS=CHANGE_ME
# [Config] IP allowlist (CIDR คั่นด้วย comma) — ว่าง = ไม่จำกัด · ต้องตั้ง TRUST_PROXY ให้ถูกก่อน
# BOOKING_INBOUND_ALLOWED_CIDRS=
# [Config] v1 (contract ของเรา) | smart-booking (เมื่อได้ spec)
# BOOKING_INBOUND_MAPPER=v1
# [Config] read API ขาออก: none (ค่าเริ่มต้น) | http — production ห้ามใช้ mock
# BOOKING_PROVIDER_DRIVER=none


# =============================================================================
# env ของระบบเดิม (`psd-bwc-web-backend`) — ลบ / เปลี่ยนก่อน deploy ระบบนี้
# =============================================================================
# ใช้ตัวใหม่แทน:
#   LOCATION_API_URL, DEVICE_LIST_API_URL,
#   LOCATION_PROVIDER_DRIVER, DEVICE_INVENTORY_DRIVER  -> DSS_DRIVER=dss + DSS_BASE_URL (ข้อ 8)
#
# ลบทิ้ง (ระบบนี้ไม่ใช้):
#   BRMS_BASE_URL, BRMS_MQ_ENABLED, BRMS_PASSWORD,
#   BRMS_TLS_INSECURE, BRMS_USERNAME                    ไม่ใช้ BRMS (DL30)
#   GPS_POLL_MAX_DEVICES                                ไม่จำกัดจำนวนกล้องต่อรอบ
#   OSRM_URL, ROAD_MATCH_DRIVER                         ไม่มี road matching
#   MAX_IMAGE_UPLOAD_MB                                 ไม่มีการอัปโหลดรูป
#   WEBHOOK_RATE_LIMIT_PER_MIN                          ไม่มี webhook เดิม (โควตาขาเข้าของ Booking กำหนดใน code)
#   SEED_ADMIN_PASSWORD, SEED_DEMO_PASSWORD             seed ใช้ได้เฉพาะ dev
#
# ยังไม่ใส่ แต่จดค่าเก็บไว้ (code ของ phase นั้นยังไม่มี · ชื่อ env อาจเปลี่ยนตอนทำ):
#   STREAM_API_URL, STREAM_API_TIMEOUT_MS, STREAM_ALLOWED_HOSTS, STREAM_PROVIDER_DRIVER,
#   PLAYBACK_API_URL, RECORDING_SEARCH_API_URL,
#   TALK_API_URL, TALK_PROVIDER_DRIVER                  [P4] ภาพสด / ย้อนหลัง / talk — ผ่าน DSS middleware ตัวเดิม
#   FFMPEG_PATH                                         [P4] export MP4 (worker media)
#   FCM_SERVICE_ACCOUNT_JSON, PUSH_PROVIDER_DRIVER      [P5] push แจ้งเตือนแอปมือถือ
#
# ใช้ต่อชื่อเดิม (ตรวจค่าตามหัวข้อด้านบน):
#   NODE_ENV, PORT, DATABASE_URL (⚠️ เปลี่ยนเป็น DB ใหม่), REDIS_URL, JWT_ACCESS_SECRET,
#   ACCESS_TOKEN_TTL, REFRESH_TOKEN_TTL_HOURS, REFRESH_TOKEN_TTL_HOURS_DEVICE, COOKIE_SECURE,
#   CORS_ORIGINS, AUTH_PASSWORD_LOGIN_ENABLED, AZURE_AD_TENANT_ID, AZURE_AD_CLIENT_ID,
#   GRAPH_TENANT_ID, GRAPH_CLIENT_ID, GRAPH_CLIENT_SECRET, GRAPH_ALLOWED_DOMAINS,
#   GRAPH_DOMAIN_FIELD, DSS_API_KEY, GPS_POLL_ENABLED, GPS_POLL_CONCURRENCY,
#   STORAGE_DRIVER, STORAGE_LOCAL_DIR
#
# เพิ่มใหม่ (ระบบเดิมไม่มี): DSS_DRIVER, DSS_BASE_URL, TRUST_PROXY, COOKIE_SAMESITE,
#   WORKER_ROLES (เฉพาะ Deployment ของ worker)
