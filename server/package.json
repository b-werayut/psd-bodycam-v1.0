{
  "name": "psd-bodycam-server",
  "version": "0.0.1",
  "private": true,
  "description": "PSD Body Worn Camera tracking system - backend (NestJS modular monolith)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start:api": "node dist/main.api.js",
    "start:api:dev": "nest start --watch --entryFile main.api",
    "start:worker": "node dist/main.worker.js",
    "start:worker:dev": "nest start --watch --entryFile main.worker",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run test:int",
    "db:prepare:test": "ts-node scripts/prepare-test-db.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:apply": "node dist/db/migrate.entry.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node src/db/seed.ts",
    "prod:check": "ts-node scripts/prod-check.ts",
    "coverage": "node scripts/ci-coverage.js",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:int:coverage": "vitest run --config vitest.integration.config.ts --coverage --reporter=default --reporter=junit --outputFile=test-results/integration-junit.xml",
    "test:ci:full": "node scripts/ci-coverage.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/websockets": "^10.4.15",
    "@node-rs/argon2": "^2.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "postgres": "^3.4.9",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@swc/core": "^1.15.47",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.13.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.9"
  }
}
