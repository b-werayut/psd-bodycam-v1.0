# =============================================================================
# PSD Body worn camera — ตัวอย่างไฟล์ตั้งค่า server (api + worker)
# =============================================================================
# คัดลอกเป็น `server/.env` แล้วแก้ค่าที่เขียนว่า CHANGE_ME
#   `.env` อยู่ใน .gitignore — ห้าม commit · ไฟล์นี้ commit ลง git จึงห้ามใส่ค่าจริง
#   (host/IP ของ DSS, tenant/client ID, รหัสผ่าน, secret ทุกตัว)
#
# ค่าตั้งต้นในไฟล์นี้ = dev บนเครื่อง local (DL63): PostgreSQL + Redis บนเครื่อง,
# DSS middleware ผ่าน VPN, Booking ใช้ mock / booking-simulator (ยังไม่มี spec จากทีม Booking)
# production ดู `.env.production.example` (รวมรายการ env ของระบบเดิมที่ต้องลบ / เปลี่ยน)
#
# ป้ายกำกับ:
#   [ใช้แล้ว]      code ตอนนี้อ่านค่านี้แล้ว
#   [P0] [P1] ...  code จะเริ่มอ่านใน phase นั้น (Part 8) — ใส่ค่าเตรียมไว้ได้ ตอนนี้ไม่มีผล
#   [prod:check]   `npm run prod:check` ตรวจค่านี้ก่อน deploy
#
# api กับ worker อ่าน .env ไฟล์เดียวกัน:
#   npm run start:api:dev     (พอร์ต PORT)
#   npm run start:worker:dev  (ไม่เปิดพอร์ต)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. โปรเซส
# -----------------------------------------------------------------------------
# [ใช้แล้ว] [prod:check] development | test | production
NODE_ENV=development

# [ใช้แล้ว] พอร์ตของ api · client (Vite) proxy `/api` และ `/socket.io` มาที่ localhost:3000
PORT=3000

# [ใช้แล้ว] ระดับ log ของ pino — ไม่ตั้ง = debug (dev) / info (production)
# LOG_LEVEL=debug

# [ใช้แล้ว] Swagger UI ที่ /api/docs (JSON /api/docs-json) — ไม่ตั้ง = เปิดเมื่อไม่ใช่ production
# production เปิดเฉพาะเมื่อตั้ง true · ตั้ง false = ปิดทุกที่
# SWAGGER_ENABLED=

# [ใช้แล้ว] บทบาทของโปรเซส worker คั่นด้วย comma: tracking, integration, media
# ไม่ตั้ง = ทุกบทบาท (dev รัน worker ตัวเดียวพอ)
# WORKER_ROLES=tracking,integration,media


# -----------------------------------------------------------------------------
# 2. ฐานข้อมูล PostgreSQL
# -----------------------------------------------------------------------------
# ⚠️ ใช้ database ใหม่ของระบบนี้ (`bwc` / `bwc_test`) เท่านั้น
#    ห้ามชี้ DB ของระบบเดิม (`internal_bodycam`, `internal_bodycam_test`) — ชื่อตารางและ
#    `drizzle.__drizzle_migrations` ชนกัน
#
# สร้างครั้งแรก (psql ด้วย user postgres):
#   CREATE ROLE bwc LOGIN CREATEDB PASSWORD 'CHANGE_ME';
#   CREATE DATABASE bwc OWNER bwc;
# แล้วรันใน server/:
#   npm run db:migrate          # สร้างตารางใน bwc
#   npm run db:prepare:test     # สร้าง bwc_test + migrate (ต้องมีสิทธิ์ CREATEDB)
#
# password ที่มีอักขระพิเศษต้อง URL-encode เช่น '@' -> %40, '#' -> %23, '!' -> %21

# [ใช้แล้ว] [prod:check]
DATABASE_URL=postgres://bwc:CHANGE_ME@localhost:5432/bwc

# [ใช้แล้ว] DB ของ integration test (`npm run test:int`) — เครื่อง dev / CI เท่านั้น
# ไม่ตั้ง = ใช้ DATABASE_URL แล้วเติม `_test` ท้ายชื่อ database
# ⚠️ test ลบ/แก้ข้อมูล — ชื่อ database ต้องลงท้าย `_test` ไม่งั้น harness ปฏิเสธ
DATABASE_URL_TEST=postgres://bwc:CHANGE_ME@localhost:5432/bwc_test

# [ใช้แล้ว] ตรวจ migration ค้างตอน boot: enforce (ค่าเริ่มต้น — ค้างแล้วไม่ boot) | warn | off
# DB_MIGRATION_CHECK=enforce

# [ใช้แล้ว] โฟลเดอร์ migration — ไม่ตั้ง = `drizzle/` (ตั้งเฉพาะ image ที่วางไว้ที่อื่น)
# DB_MIGRATIONS_DIR=


# -----------------------------------------------------------------------------
# 3. Redis — Socket.IO adapter, lock, rate limit, BullMQ, cache สถานะกล้อง
# -----------------------------------------------------------------------------
# dev: container `redis` บน Docker (`docker start redis` ถ้ายังไม่รัน)
# [ใช้แล้ว] [prod:check]
REDIS_URL=redis://localhost:6379

# [ใช้แล้ว] timeout ตอนต่อ Redis (ms, 500–60000) — ไม่ตั้ง = 5000
# REDIS_CONNECT_TIMEOUT_MS=5000


# -----------------------------------------------------------------------------
# 4. หน้าเว็บ + reverse proxy + cookie
# -----------------------------------------------------------------------------
# [ใช้แล้ว] [prod:check] origin ของหน้าเว็บ คั่นด้วย comma (REST + Socket.IO) · ห้ามใช้ `*`
# ไม่ตั้ง = ค่า dev: http://localhost:5173, http://127.0.0.1:5173, http://localhost:4173,
#          http://localhost:3000
# CORS_ORIGINS=http://localhost:5173

# [ใช้แล้ว] [prod:check] ค่าของ `app.set('trust proxy', …)`
# ไม่ตั้ง = loopback (dev ใช้ได้) · บน Kubernetes ตั้ง 2 (ingress + nginx ของ web)
# ห้ามตั้ง true / all / * — เชื่อ X-Forwarded-For ที่ผู้เรียกส่งมาเอง (ปลอม IP ได้)
# TRUST_PROXY=loopback

# [ใช้แล้ว] [prod:check] true เมื่อเว็บเป็น HTTPS · dev บน http://localhost ใช้ false
COOKIE_SECURE=false

# [ใช้แล้ว] [prod:check] SameSite ของ refresh cookie: lax (ค่าเริ่มต้น) | none | strict
COOKIE_SAMESITE=lax


# -----------------------------------------------------------------------------
# 5. Auth (ชื่อผู้ใช้ + รหัสผ่าน, JWT, refresh token)
# -----------------------------------------------------------------------------
# [ใช้แล้ว] [prod:check] อย่างน้อย 32 ตัวอักษรที่สุ่มมา — สร้างด้วย: openssl rand -base64 48
# dev ไม่ตั้ง = ใช้ค่า fallback ที่ไม่ปลอดภัย · production ไม่ตั้ง = boot ไม่ขึ้น
# ไม่มี JWT_REFRESH_SECRET โดยเจตนา: refresh token เป็นค่าสุ่มที่เก็บ hash ใน RefreshTokens
JWT_ACCESS_SECRET=CHANGE_ME_random_at_least_32_characters

# [ใช้แล้ว] อายุ access token — ไม่ตั้ง = 15m
# ACCESS_TOKEN_TTL=15m

# [ใช้แล้ว] [prod:check] อายุ refresh token ของเว็บ (ชั่วโมง, sliding) — ไม่ตั้ง = 8
# REFRESH_TOKEN_TTL_HOURS=8

# [P5] [prod:check] อายุ refresh token ของแอปมือถือที่ลงทะเบียนเครื่องแล้ว (ชั่วโมง)
# ไม่ตั้ง = เท่ากับเว็บ · ตัวอย่าง 720 = 30 วัน
# REFRESH_TOKEN_TTL_HOURS_DEVICE=

# [ใช้แล้ว] [prod:check] login ด้วยชื่อผู้ใช้ + รหัสผ่าน — ค่าเริ่มต้น true
# ปิด (false) พร้อมกับไม่ตั้ง AZURE_AD_* = ไม่มีทางเข้าระบบ (boot ไม่ขึ้น)
AUTH_PASSWORD_LOGIN_ENABLED=true

# [ใช้แล้ว] โควตาต่อ IP ต่อนาที — ไม่ตั้ง = ค่าในวงเล็บ
# AUTH_LOGIN_RATE_LIMIT_PER_MIN=60
# AUTH_SSO_RATE_LIMIT_PER_MIN=60
# AUTH_REFRESH_RATE_LIMIT_PER_MIN=120

# [ใช้แล้ว] รหัสบัญชี dev seed (`npm run db:seed` — ปฏิเสธเมื่อ NODE_ENV=production)
#   admin (ADMIN)                       = SEED_ADMIN_PASSWORD  (ไม่ตั้ง = Admin@12345)
#   companyadmin1, operator1, viewer1   = SEED_DEMO_PASSWORD   (ไม่ตั้ง = Demo@12345)
# [prod:check] production ต้องไม่ตั้ง SEED_DEMO_PASSWORD
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=


# -----------------------------------------------------------------------------
# 6. Microsoft Entra ID — เข้าสู่ระบบด้วยบัญชีองค์กร (SSO)
# -----------------------------------------------------------------------------
# [ใช้แล้ว] [prod:check] จาก Azure Portal > App registrations > (แอป SSO ของระบบนี้) > Overview
#   AZURE_AD_TENANT_ID = Directory (tenant) ID
#   AZURE_AD_CLIENT_ID = Application (client) ID
# ต้องตั้งครบทั้งคู่และเป็น GUID · ไม่ตั้งเลย = ปิด SSO (เหลือชื่อผู้ใช้ + รหัสผ่าน)
# localhost: แอปต้องมี Redirect URI แบบ SPA `http://localhost:5173`
#   (ตอนนี้แอป dev มีแค่โดเมนของ psd-bwc-frontend — ต้องเพิ่มก่อน)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=

# [ใช้แล้ว] จำกัดโดเมนอีเมลที่เข้าได้ คั่นด้วย comma — ว่าง = ไม่จำกัด
# AZURE_AD_ALLOWED_EMAIL_DOMAINS=


# -----------------------------------------------------------------------------
# 7. Microsoft Graph — หน้า ผู้ใช้จาก Entra (`/entra-users`) เท่านั้น
# -----------------------------------------------------------------------------
# [ใช้แล้ว] ไม่ตั้ง = ระบบใช้ได้ แต่ `/users/entra-directory` และ `/users/sync-entra` ตอบ 400
#      GRAPH_NOT_CONFIGURED
# ต้องเป็น App registration คนละตัวกับแอป SSO:
#   Application permission `User.Read.All` + admin consent · มี client secret (จดวันหมดอายุ)
# GRAPH_TENANT_ID ไม่ตั้ง = ใช้ AZURE_AD_TENANT_ID
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ดึงเฉพาะบัญชีที่โดเมนตรง (คั่นด้วย comma) — ไม่ตั้ง = ใช้ AZURE_AD_ALLOWED_EMAIL_DOMAINS · ว่างทั้งคู่ = ไม่จำกัด
# GRAPH_ALLOWED_DOMAINS=
# โดเมนเทียบกับช่องไหน: userPrincipalName (ค่าเริ่มต้น) | mail
# GRAPH_DOMAIN_FIELD=userPrincipalName
# true = ดึงทุกบัญชีรวม guest / ที่ปิดใช้งาน (ไว้ไล่ปัญหาเท่านั้น)
# GRAPH_INCLUDE_ALL=false


# -----------------------------------------------------------------------------
# 8. DSS middleware (`psd-bwc-dss-services`) — GPS + สถานะกล้อง, รายการกล้อง, live, playback, talk
# -----------------------------------------------------------------------------
# [P1] dev เข้าผ่าน VPN · middleware เก็บ token ของ Dahua DSS Platform เอง ระบบเราไม่ต้องรู้
# ทุกคำขอแนบ JWT (HS256 อายุ 60 วินาที) ที่ sign ด้วย DSS_API_KEY — นาฬิกาสองเครื่องต้องคลาดกันไม่เกิน 30 วินาที

# [P1] dss = เรียก psd-bwc-dss-services จริง | mock = กล้องจำลอง (ค่าเริ่มต้น — ไม่ต้องต่อ VPN)
# production ต้องเป็น dss
DSS_DRIVER=mock

# [P1] host:port ของ psd-bwc-dss-services (ไม่ต้องมี /api/v1 — ระบบต่อ path เอง) · ใช้เมื่อ DSS_DRIVER=dss
# DSS_BASE_URL=http://CHANGE_ME_DSS_HOST:3004

# [P1] = API_SECRET_KEY ใน .env ของ psd-bwc-dss-services (ความยาว 32 ตัวขึ้นไป) · ใช้เมื่อ DSS_DRIVER=dss
# DSS_API_KEY=CHANGE_ME

# [P1] timeout ต่อคำขอ (ms) 1000–60000
# DSS_TIMEOUT_MS=10000

# [P1] จำนวนกล้องจำลองเมื่อ DSS_DRIVER=mock (1–1000)
# DSS_MOCK_DEVICES=100

# ภาพสดหลายจอ: ค่าเริ่มต้น POST ${DSS_BASE_URL}/api/v1/stream (JWT เดียวกับ DSS)
# เปลี่ยนเมื่อ streaming endpoint อยู่คนละที่
# STREAM_API_URL=https://CHANGE_ME_DSS_HOST/api/v1/stream
# Hostname ของ media ที่ DSS ส่งกลับ (คั่นด้วย comma ไม่ใส่ scheme/path)
# ไม่ตั้ง = อนุญาตเฉพาะ host ของ DSS_BASE_URL / STREAM_API_URL
# STREAM_ALLOWED_HOSTS=CHANGE_ME_DSS_HOST
# AES-256-GCM สำหรับซ่อน vendor URL; ไม่ตั้งใช้ JWT_ACCESS_SECRET
# ต้องเป็นค่าเดียวกันทุก API replica
# STREAM_URL_SECRET=CHANGE_ME_RANDOM_SECRET

# [P1] worker role tracking: ดึงพิกัด + สถานะกล้องทุกรอบ (รอบตั้งที่หน้า ตั้งค่าระบบ gps.poll-interval-seconds)
# false = ปิด (เช่นเครื่อง dev ที่ไม่อยากให้ worker ยิง DSS)
# GPS_POLL_ENABLED=true
# จำนวนคำขอ /location พร้อมกัน (1–32) · DSS ตอบราว 0.6 วินาที/กล้อง ⇒ 100 กล้อง 8 คำขอ ≈ 8 วินาที/รอบ
# GPS_POLL_CONCURRENCY=8


# -----------------------------------------------------------------------------
# 9. Booking (Smart Booking) — ตอนนี้ใช้ mock
# -----------------------------------------------------------------------------
# ยังไม่มี spec จากทีม Booking (P3c รอ spec) ⇒ dev ใช้ contract v1 ของเรา (Part 7)
#   - ใบงานเข้ามาทาง POST /api/integration/booking/jobs (push — DL46)
#   - dev จำลองด้วย `npm run booking:simulate -- <scenario>` (P3a) ซึ่ง sign ด้วย secret ตัวแรก
#     ของ BOOKING_INBOUND_SECRETS แล้ว POST เข้า endpoint จริง
#   - read API ขาออกใช้ driver `mock` (เสิร์ฟ fixture) แทน Booking จริง

# [P3a] วิธีตรวจ POST ขาเข้า: hmac (ค่าเริ่มต้น) | api-key
BOOKING_INBOUND_AUTH=hmac

# [P3a] secret ขาเข้า คั่นด้วย comma ได้ 2 ตัว (หมุน secret โดยไม่ดับ)
# dev ใส่ค่าอะไรก็ได้ที่สุ่มมา · production มาจาก Kubernetes Secret
BOOKING_INBOUND_SECRETS=CHANGE_ME_dev_booking_secret

# [P3a] IP allowlist ของ POST ขาเข้า (CIDR คั่นด้วย comma) — ว่าง = ไม่จำกัด
# ต้องตั้ง TRUST_PROXY ให้ถูกก่อน ไม่งั้น IP ที่เห็นเป็นของ proxy
# BOOKING_INBOUND_ALLOWED_CIDRS=

# [P3a] ตัวแปลง body ขาเข้า: v1 (contract ของเรา) | smart-booking (เขียนเมื่อได้ spec — P3c)
BOOKING_INBOUND_MAPPER=v1

# [P3a] read API ขาออก (optional): none (ค่าเริ่มต้น) | mock | http
# dev ใช้ mock · http ใช้เมื่อ Booking มี read API จริง (P3c)
BOOKING_PROVIDER_DRIVER=mock


# -----------------------------------------------------------------------------
# 10. ไฟล์ export MP4 (วิดีโอย้อนหลัง) — Local disk, ลบหลัง 24 ชม. (DL34)
# -----------------------------------------------------------------------------
# [P4] api กับ worker media ต้องเห็นโฟลเดอร์เดียวกัน (production = PVC)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# [P4] งานแปลงพร้อมกันของ worker media (1–8) และ timeout ต่องาน (นาที)
# EVIDENCE_EXPORT_CONCURRENCY=1
# EVIDENCE_EXPORT_TIMEOUT_MINUTES=180


# -----------------------------------------------------------------------------
# 11. dev / test เท่านั้น
# -----------------------------------------------------------------------------
# [ใช้แล้ว] 1 = integration test พิมพ์ log ละเอียด
# VITEST_INT_VERBOSE=1
